{
  "name": "@nether/vault-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generates the reference vault of Markdown notes that Nether's performance tests run against.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/generate.ts"
  },
  "scripts": {
    "generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^5.0.5"
  }
}
