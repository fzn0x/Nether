{
  "name": "nether",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source workspace that joins Obsidian's local-first Markdown notes with Notion's databases and collaboration, on a server you control.",
  "license": "AGPL-3.0-or-later",
  "author": "fzn0x",
  "homepage": "https://fzn0x.github.io/Nether/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzn0x/Nether.git"
  },
  "bugs": "https://github.com/fzn0x/Nether/issues",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "vault:generate": "pnpm --filter @nether/vault-generator generate",
    "perf:bench": "pnpm --filter @nether/perf bench",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
