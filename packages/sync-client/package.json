{
  "name": "@nether/sync-client",
  "version": "0.0.0",
  "private": true,
  "description": "Syncing a vault with a workspace on a Nether server: the vault document that lists its notes, and each note's Yjs document, kept between runs for edits made offline.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@hocuspocus/provider": "~4.7.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@nether/server": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
