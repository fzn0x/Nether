{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"],
    // The integration tests reach the editor's components through its package.
    "jsx": "react-jsx",
    // The end-to-end tests pass functions to page.evaluate, which run in the page.
    "lib": ["es2024", "dom"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.perf.config.ts",
    "e2e",
    "perf",
    "integration"
  ]
}
